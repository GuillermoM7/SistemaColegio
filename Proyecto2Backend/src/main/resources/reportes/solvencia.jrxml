<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" 
              name="SolvenciaAcademica" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="50" bottomMargin="50">
    
    <parameter name="id_estudiante" class="java.lang.Integer"/>
    
    <queryString>
        <![CDATA[
            SELECT id_estudiante, nombres, apellidos, DATE_FORMAT(CURDATE(), '%d/%m/%Y') AS fecha_actual 
            FROM estudiante 
            WHERE id_estudiante = $P{id_estudiante}
        ]]>
    </queryString>
    
    <field name="id_estudiante" class="java.lang.Integer"/>
    <field name="nombres" class="java.lang.String"/>
    <field name="apellidos" class="java.lang.String"/>
    <field name="fecha_actual" class="java.lang.String"/>
    
    <title>
        <band height="100">
            <staticText>
                <reportElement x="0" y="20" width="555" height="40"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="22" isBold="true"/>
                </textElement>
                <text><![CDATA[CERTIFICADO DE SOLVENCIA]]></text>
            </staticText>
            <line>
                <reportElement x="50" y="70" width="455" height="1"/>
            </line>
        </band>
    </title>
    
    <detail>
        <band height="300">
            <staticText>
                <reportElement x="50" y="30" width="455" height="20"/>
                <textElement textAlignment="Justified">
                    <font size="14"/>
                </textElement>
                <text><![CDATA[La Dirección Administrativa Financiera de la institución,]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="50" y="70" width="455" height="20"/>
                <textElement textAlignment="Center">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[HACE CONSTAR QUE:]]></text>
            </staticText>
            
            <textField>
                <reportElement x="50" y="120" width="455" height="80"/>
                <textElement textAlignment="Justified">
                    <font size="14"/>
                </textElement>
                <textFieldExpression><![CDATA["El(la) estudiante " + $F{nombres} + " " + $F{apellidos} + " con número de identificación " + $F{id_estudiante} + ", se encuentra actualmente SOLVENTE de todo pago de colegiaturas, inscripciones y responsabilidades de biblioteca hasta la fecha de emisión de este documento."]]></textFieldExpression>
            </textField>
            
            <textField>
                <reportElement x="50" y="250" width="455" height="20"/>
                <textElement textAlignment="Right">
                    <font size="12"/>
                </textElement>
                <textFieldExpression><![CDATA["Emitido el: " + $F{fecha_actual}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    
    <summary>
        <band height="150">
            <line>
                <reportElement x="177" y="80" width="200" height="1"/>
            </line>
            <staticText>
                <reportElement x="177" y="90" width="200" height="20"/>
                <textElement textAlignment="Center">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Sello y Firma Autorizada]]></text>
            </staticText>
        </band>
    </summary>
</jasperReport>